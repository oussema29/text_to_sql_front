server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Reverse-proxy the API to the backend container so both are served from the same origin —
    # required for the backend's httpOnly bq_token cookie (SameSite=Strict) and CSRF double-submit
    # cookie to work without cross-origin cookie issues.
    location /api/ {
        # BACKEND_URL/BACKEND_SCHEME are substituted at container startup (envsubst, via nginx's
        # own /etc/nginx/templates/ mechanism, see Dockerfile). Locally: "backend:8080" over plain
        # http (a Docker-internal service name, no TLS involved at all). On Render (or any platform
        # where frontend/backend are separate public services with no private network between them):
        # the real public backend hostname, over https — required, since the backend's own Render
        # edge force-redirects plain-HTTP requests to HTTPS, and nginx's default proxy_redirect then
        # rewrites that Location header to the FRONTEND's own origin, causing an infinite redirect
        # loop back to this exact URL (observed and confirmed live before this fix).
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_URL}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The text-to-SQL pipeline can chain up to 3 self-correction attempts
        # (TextToSqlPipelineService.MAX_ATTEMPTS), each an LLM call with its own 120s timeout
        # (langchain4j.ollama.chat-model.timeout), plus a contextualizer LLM call — worst case
        # comfortably exceeds nginx's 60s default proxy_read_timeout, which was observed cutting off
        # a real query with a 504 before the backend could finish. 300s covers that worst case with
        # headroom without proxy_send_timeout (upload side; the request body here is tiny anyway).
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
    }

    # Angular router fallback (client-side routing).
    location / {
        try_files $uri $uri/ /index.html;
    }
}